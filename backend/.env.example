# Copia este archivo como .env y completa los valores. El archivo .env nunca se sube al repositorio.

# Cadena de conexión de Neon (en Neon: Connect > Connection string).
# Cambia sslmode=require por sslmode=verify-full: es lo que el driver pg ya aplica y evita su aviso de seguridad.
DATABASE_URL=postgresql://usuario:contrasena@servidor.neon.tech/trompo_feliz?sslmode=verify-full

# Puerto de la API en local. En Render no se configura: Render asigna el suyo.
PORT=4000

# Frontend que puede llamar a la API desde el navegador (CORS). Varias URL separadas por comas.
# En Render va la URL de Vercel. Si se deja vacía, solo se permite http://localhost:3000.
FRONTEND_URL=http://localhost:3000

# Clave con la que se firman los JWT de la sesión: 32 caracteres o más, distinta en local y en Render.
# Para generarla: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Sin esta variable la API no arranca.
JWT_SECRET=

# Usuarios de prueba que crea "npm run db:preparar" (contraseñas de 8 caracteres o más).
SEED_ADMIN_CORREO=admin@eltrompofeliz.test
SEED_ADMIN_CONTRASENA=
SEED_CLIENTE_CORREO=cliente@eltrompofeliz.test
SEED_CLIENTE_CONTRASENA=
